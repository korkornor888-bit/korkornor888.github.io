<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0A0A0C">
<title>ระบบจัดการงาน — ฝ่ายนโยบาย</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
*{scrollbar-width:thin;scrollbar-color:rgba(255,184,0,.3) transparent}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-thumb{background:rgba(255,184,0,.3);border-radius:99px}
::-webkit-scrollbar-track{background:transparent}

:root{
  --ink:#F4F4F5; 
  --ink-soft:#A1A1AA; 
  --ink-mute:#71717A;
  --line:rgba(255,255,255,.08); 
  --line-soft:rgba(255,255,255,.04); 
  --surface:#18181B; 
  --surface-hover:#27272A;
  --canvas:#0A0A0C;
  --brand:#FFB800; 
  --brand-strong:#FFC72C; 
  --brand-wash:rgba(255,184,0,.12);
  --good:#10B981; 
  --good-wash:rgba(16,185,129,.12);
  --warn:#38BDF8; 
  --warn-wash:rgba(56,189,248,.12);
  --bad:#EF4444; 
  --bad-wash:rgba(239,68,68,.12); 
  --bad-line:rgba(239,68,68,.3);
  --radius-lg:16px; 
  --radius-md:12px; 
  --radius-sm:8px; 
  --radius-pill:999px;
  --shadow-card:0 4px 20px rgba(0,0,0,.4);
  --shadow-pop:0 20px 40px rgba(0,0,0,.6);
  --focus-ring:0 0 0 2px rgba(255,184,0,.4);
}

html{-webkit-text-size-adjust:100%;overflow-x:hidden}
*::selection{background:var(--brand-wash);color:var(--brand-strong)}
body{
  font-family:'Sarabun','Noto Sans Thai',Tahoma,'Segoe UI',system-ui,sans-serif;
  margin:0;background:var(--canvas);color:var(--ink);font-size:14.5px;line-height:1.5;
  -webkit-font-smoothing:antialiased;
  padding-bottom:env(safe-area-inset-bottom);
  overflow-wrap:break-word;
  overflow-x:hidden;
  min-height:100vh;
  min-height:100dvh;
}
img,svg{max-width:100%;display:block}

/* -- Accessibility & Focus -- */
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,
textarea:focus-visible,[tabindex]:focus-visible{
  outline:none;box-shadow:var(--focus-ring);border-radius:var(--radius-sm);
}

.wrap{max-width:880px;margin:0 auto;padding:20px 16px 48px;min-width:0}
@media(min-width:768px){.wrap{padding:28px 24px 64px}}

.top{
  background:rgba(10,10,12,.85);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line);padding:14px 20px;
  padding-top:calc(14px + env(safe-area-inset-top));
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  position:sticky;top:0;z-index:30;
}
.top h1{font-size:16px;margin:0;font-weight:700;color:var(--ink);letter-spacing:-.01em}
.who{font-size:12px;color:var(--ink-mute);margin-top:1px;font-weight:500}

/* -- Modern Buttons -- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  min-height:38px;padding:8px 16px;font-size:13px;font-weight:600;
  border-radius:var(--radius-md);border:1px solid transparent;cursor:pointer;font-family:inherit;
  transition:all .15s ease;white-space:nowrap;
}
.btn:active{transform:scale(.97)}
.bp{background:var(--brand);color:#0A0A0C;font-weight:700;border:none}
.bp:hover{background:var(--brand-strong)}
.bg{background:var(--surface);color:var(--ink);border-color:var(--line)}
.bg:hover{background:var(--surface-hover);border-color:rgba(255,255,255,.15)}
.bd{background:transparent;color:var(--bad);border-color:rgba(239,68,68,.25)}
.bd:hover{background:var(--bad-wash);border-color:var(--bad)}
.bs{background:var(--good);color:#0A0A0C;font-weight:700}

/* -- Bento Cards -- */
.card{
  background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);
  padding:20px;margin-bottom:16px;position:relative;box-shadow:var(--shadow-card);
  min-width:0;
}
.card[onclick]{cursor:pointer;transition:border-color .15s ease,transform .1s ease}
.card[onclick]:hover{border-color:rgba(255,184,0,.3)}

.chip{
  display:inline-block;background:rgba(255,255,255,.06);color:var(--ink-soft);
  font-size:11px;font-weight:600;padding:2px 8px;border-radius:var(--radius-sm);margin-right:6px;
}
.kind{display:inline-block;font-size:11px;font-weight:700;padding:2px 8px;border-radius:var(--radius-sm)}
.k-i{background:var(--warn-wash);color:var(--warn)}
.k-p{background:var(--brand-wash);color:var(--brand-strong)}
.badge{display:inline-block;font-size:11px;font-weight:700;padding:3px 10px;border-radius:var(--radius-pill);background:var(--brand-wash);color:var(--brand-strong)}
.stale{display:inline-block;font-size:11px;font-weight:700;padding:3px 10px;border-radius:var(--radius-pill);background:var(--bad-wash);color:var(--bad);margin-left:6px}
.muted{color:var(--ink-mute);font-size:12.5px;line-height:1.5}

.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
@media(max-width:600px){.quick{grid-template-columns:repeat(2,1fr)}}
.q{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-md);padding:14px;text-align:center}
.q b{display:block;font-size:22px;line-weight:1.1;font-weight:700;color:var(--brand-strong)}
.q span{font-size:11px;color:var(--ink-mute);font-weight:500}

.filters{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:12px}
@media(max-width:768px){.filters{grid-template-columns:1fr}}

.strip{display:flex;gap:4px;margin-top:10px}
.strip i{flex:1;height:4px;border-radius:99px;background:var(--line-soft)}
.strip i.on{background:var(--brand)}

.sec{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);margin-bottom:16px;overflow:hidden;box-shadow:var(--shadow-card)}
.sec-h{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;cursor:pointer;user-select:none;font-weight:600;font-size:14.5px}
.sec-h .ar{color:var(--brand);font-size:11px;transition:transform .2s ease}
.sec.open .sec-h .ar{transform:rotate(90deg)}
.sec-b{padding:0 20px 20px;display:none;border-top:1px solid var(--line-soft)}
.sec.open .sec-b{display:block;animation:fadeIn .15s ease}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

.done-sub{
  font-size:12.5px;color:var(--good);margin-top:2px;display:flex;align-items:center;gap:4px;
}

.entry{border-left:2px solid var(--line);padding:8px 0 8px 12px;margin-bottom:8px}
.entry.has-contact{border-left-color:var(--brand)}
.entry .r1{display:flex;justify-content:space-between;gap:10px}
.entry .ti{font-weight:600;font-size:13.5px;color:var(--ink)}
.entry .dt{font-size:11px;color:var(--ink-mute)}
.entry .de{font-size:13px;color:var(--ink-soft);margin-top:4px;white-space:pre-wrap}
.entry .ct{display:inline-block;font-size:11px;background:var(--warn-wash);color:var(--warn);padding:2px 8px;border-radius:var(--radius-pill);margin-top:6px}
.entry .sg{display:inline-block;font-size:10.5px;background:var(--brand-wash);color:var(--brand-strong);padding:2px 8px;border-radius:var(--radius-pill);margin-right:6px;font-weight:700}

label{display:block;font-size:12px;font-weight:600;color:var(--ink-soft);margin:14px 0 6px;text-transform:uppercase;letter-spacing:.03em}
input,textarea,select{
  width:100%;padding:10px 14px;font-size:14px;font-family:inherit;
  border:1px solid var(--line);border-radius:var(--radius-md);background:#0F0F12;
  color:var(--ink);transition:border-color .15s ease;
}
select{
  appearance:none;-webkit-appearance:none;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='%2371717A'><path fill-rule='evenodd' d='M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.25a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z' clip-rule='evenodd'/></svg>");
  background-repeat:no-repeat;background-position:right 12px center;background-size:16px;
  padding-right:36px;
}
input::placeholder,textarea::placeholder{color:var(--ink-mute)}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--brand)}
textarea{min-height:72px;resize:vertical;line-height:1.5}

/* -- Segmented Controls (Capsule Radio Buttons) -- */
.radios{display:flex;flex-wrap:wrap;gap:6px;background:#0F0F12;padding:4px;border-radius:var(--radius-md);border:1px solid var(--line)}
.radio{
  flex:1;min-width:100px;text-align:center;padding:8px 12px;border-radius:var(--radius-sm);
  font-size:12.5px;font-weight:500;cursor:pointer;color:var(--ink-mute);transition:all .15s ease;
  border:none;background:transparent;
}
.radio:hover{color:var(--ink)}
.radio.on{background:var(--surface);color:var(--brand-strong);font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,.3)}

/* -- Modern Stepper Bar -- */
.tabs{
  display:flex;align-items:center;justify-content:space-between;
  position:relative;margin-bottom:24px;padding:0 10px;
}
.tabs::before{
  content:"";position:absolute;top:18px;left:40px;right:40px;height:2px;
  background:var(--line);z-index:1;
}
.tab{
  position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;
  cursor:pointer;background:transparent;border:none;padding:0;
}
.tab-num{
  width:36px;height:36px;border-radius:50%;background:var(--surface);
  border:2px solid var(--line);color:var(--ink-mute);display:flex;
  align-items:center;justify-content:center;font-size:13px;font-weight:700;
  transition:all .2s ease;
}
.tab-label{font-size:11.5px;font-weight:500;color:var(--ink-mute);margin-top:6px;transition:color .2s ease}
.tab:hover .tab-num{border-color:rgba(255,184,0,.5);color:var(--ink)}
.tab.on .tab-num{background:var(--brand);border-color:var(--brand);color:#0A0A0C;box-shadow:0 0 12px rgba(255,184,0,.3)}
.tab.on .tab-label{color:var(--brand-strong);font-weight:700}

.tag{display:inline-flex;align-items:center;gap:6px;background:var(--brand-wash);color:var(--brand-strong);font-size:12px;font-weight:600;padding:3px 10px;border-radius:var(--radius-pill);margin:3px 4px 0 0}
.tag b{cursor:pointer;opacity:.7}

.sug{border:1px solid var(--line);border-radius:var(--radius-md);margin-top:4px;max-height:160px;overflow-y:auto;background:#0F0F12}
.sug div{padding:8px 12px;cursor:pointer;font-size:12.5px;border-bottom:1px solid var(--line-soft)}
.sug div:hover{background:var(--brand-wash);color:var(--brand-strong)}

.center{text-align:center;padding:40px 16px;color:var(--ink-mute);font-size:13.5px}
.hidden{display:none!important}
.spin{display:inline-block;width:16px;height:16px;border:2px solid var(--brand-wash);border-top-color:var(--brand);border-radius:50%;animation:sp .7s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}

.toast{
  position:fixed;bottom:24px;right:24px;background:#1F1F23;color:var(--ink);
  padding:10px 18px;border-radius:var(--radius-md);border:1px solid var(--line);
  font-size:13px;font-weight:500;z-index:60;box-shadow:var(--shadow-pop);
}

.err{background:var(--bad-wash);color:var(--bad);border:1px solid var(--bad-line);padding:12px 14px;border-radius:var(--radius-md);font-size:13px}

.login-wrap{
  min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;
  background:radial-gradient(circle at top, rgba(255,184,0,.08), transparent 50%), #0A0A0C;
}
.login-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);padding:32px;max-width:380px;width:100%;box-shadow:var(--shadow-pop)}
.login-card h2{margin:0 0 4px;font-size:20px;text-align:center;font-weight:700;color:var(--ink)}
.login-card p{color:var(--ink-mute);font-size:13px;margin:0 0 20px;text-align:center}

.xdel{position:absolute;top:16px;right:16px;font-size:11px;font-weight:600;color:var(--bad);background:transparent;border:1px solid var(--bad-line);border-radius:var(--radius-pill);padding:2px 10px;cursor:pointer;transition:all .15s ease}
.xdel:hover{background:var(--bad-wash)}

table.ftbl{width:100%;border-collapse:collapse;font-size:12.5px}
table.ftbl th{text-align:left;border-bottom:1px solid var(--line);padding:8px 10px;background:rgba(255,255,255,.02);color:var(--ink-soft)}
table.ftbl td{border-bottom:1px solid var(--line-soft);padding:8px 10px;color:var(--ink-soft)}

@media(prefers-reduced-motion:reduce){
  *{animation-duration:.001ms!important;transition-duration:.001ms!important}
}
</style>
</head>
