}
function curLinks(stage, key) { var v = D.fields[stage + "|" + key] || ""; return v ? v.split(",").map(function (s) { return s.trim(); }).filter(Boolean) : []; }
function link_(stage, key, code) { var arr = curLinks(stage, key); if (arr.indexOf(code) < 0) arr.push(code); D.fields[stage + "|" + key] = arr.join(", "); svf(stage, key, arr.join(", ")); drawWork(); }
function unlink(stage, key, code) { var arr = curLinks(stage, key).filter(function (c) { return c !== code; }); D.fields[stage + "|" + key] = arr.join(", "); svf(stage, key, arr.join(", ")); drawWork(); }

/* ---- list-type field (repeatable dated items, multi-select delete with confirm) ---- */
function logEntries(stage, key) { var v = D.fields[stage + "|" + key] || "[]"; try { return JSON.parse(v) || []; } catch (e) { return []; } }
function listAdd(stage, key) {
