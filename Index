    b.id = "bulkBar";
    b.style.cssText = "position:fixed;left:50%;transform:translateX(-50%);bottom:24px;background:#18181B;color:#fff;padding:10px 16px;border-radius:12px;border:1px solid rgba(255,255,255,.1);box-shadow:var(--shadow-pop);z-index:55;display:flex;gap:10px;align-items:center;";
    b.innerHTML = '<span style="font-size:13px;font-weight:600">เลือกแล้ว ' + SELECTED.size + ' รายการ</span>' +
      '<button class="btn bg" style="min-height:32px;padding:4px 12px;font-size:12px" onclick="bulkRestore()">กู้คืนที่เลือก</button>' +
      '<button class="btn bd" style="min-height:32px;padding:4px 12px;font-size:12px" onclick="bulkPermanentDelete(\'trash\')">ลบถาวรที่เลือก</button>' +
      '<button class="btn bg" style="min-height:32px;padding:4px 12px;font-size:12px" onclick="SELECTED.clear();drawTrash()">ยกเลิก</button>';
    document.body.appendChild(b);
  }
}
function bulkRestore() {
  if (!SELECTED.size) return;
  if (!confirm("กู้คืน " + SELECTED.size + " รายการที่เลือก?")) return;
  sb.from("works").update({ archive: "ใช้งาน", deleted_at: null }).in("code", Array.from(SELECTED)).then(function (r) {
    if (r.error) toast(r.error.message); else { toast("กู้คืนแล้ว"); SELECTED.clear(); renderTrash(); }
  });
}
function restoreWork(code) {
  sb.from("works").update({ archive: "ใช้งาน", deleted_at: null }).eq("code", code).then(function (r) { if (r.error) toast(r.error.message); else renderTrash(); });
}
function permanentDelete(code, name) {
  var t = prompt('พิมพ์ชื่องาน "' + name + '" เพื่อยืนยันลบถาวร (กู้คืนไม่ได้)');
  if (t !== name) { if (t !== null) toast("ชื่อไม่ตรง ยกเลิกการลบ"); return; }
  sb.from("works").delete().eq("code", code).then(function (r) { if (r.error) toast(r.error.message); else { toast("ลบถาวรแล้ว"); renderTrash(); } });
}

/* ---------------- users + backup (head only) ---------------- */
function renderUsers() {
  app.innerHTML = '<div class="top"><button class="btn bg" onclick="renderHome()">← กลับ</button><h1>จัดการผู้ใช้</h1><div></div></div>' +
    '<div class="wrap">' +
    '<div class="card"><div style="font-weight:600;margin-bottom:8px">สร้างบัญชีใหม่</div>' +
    '<label>ชื่อที่แสดง</label><input id="nu_name">' +
    '<label>อีเมล</label><input id="nu_email" type="email">' +
    '<label>รหัสผ่านตั้งต้น</label><input id="nu_pass" type="text" placeholder="อย่างน้อย 6 ตัวอักษร">' +
    '<label>บทบาท</label><select id="nu_role"><option value="member">สมาชิก</option><option value="head">หัวจ่าย</option></select>' +
    '<button class="btn bp" style="margin-top:12px" onclick="createUserAsHead()">สร้างบัญชี</button>' +
    '<div class="muted" style="margin-top:6px">แจ้งอีเมล+รหัสผ่านนี้ให้เจ้าตัวไปเข้าสู่ระบบเองอีกที</div></div>' +
    '<div id="userList" class="center"><span class="spin"></span></div>' +
    '<div class="card"><div style="font-weight:600;margin-bottom:8px">สำรองข้อมูล</div>' +
    '<div class="muted" style="margin-bottom:12px">ระบบสำรองข้อมูลอัตโนมัติทุกวันอาทิตย์อยู่แล้ว หรือกดสำรองเองตอนนี้ก็ได้</div>' +
    '<div style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn bp" onclick="backupNow()">สำรองข้อมูลตอนนี้</button><button class="btn bg" onclick="downloadBackup()">ดาวน์โหลดสำรองล่าสุด</button></div></div></div>';
  loadUserList();
}
function loadUserList() {
  sb.from("profiles").select("*").order("created_at").then(function (r) {
    var box = document.getElementById("userList");
    if (r.error) { box.innerHTML = '<div class="err">' + esc(r.error.message) + '</div>'; return; }
    box.innerHTML = (r.data || []).map(function (u) {
      var me = u.id === ME.id;
      return '<div class="card">' +
        '<label>ชื่อที่แสดง</label><input value="' + esc(u.name) + '" onchange="renameUser(\'' + u.id + '\',this.value)">' +
        '<div class="muted" style="margin-top:4px">' + esc(u.email) + ' <span style="opacity:.7">(เปลี่ยนอีเมลทำในแอปนี้ไม่ได้ ต้องให้เจ้าตัวเปลี่ยนเอง)</span></div>' +
        '<label>บทบาท</label><select onchange="setRole(\'' + u.id + '\',this.value)" ' + (me ? "disabled" : "") + '>' +
        '<option value="member"' + (u.role === "member" ? " selected" : "") + '>สมาชิก</option>' +
        '<option value="head"' + (u.role === "head" ? " selected" : "") + '>หัวจ่าย</option></select>' +
        (me ? "" : '<button class="btn bd" style="margin-top:12px" onclick="deleteMember(\'' + u.id + '\',\'' + esc(u.name).replace(/'/g, "\\'") + '\')">ลบสมาชิกออกจากระบบ</button>') +
        '</div>';
    }).join("");
  });
}
function setRole(id, role) {
  sb.from("profiles").update({ role: role }).eq("id", id).then(function (r) { if (r.error) toast(r.error.message); else toast("ปรับสิทธิ์แล้ว"); });
}
function renameUser(id, name) {
  name = name.trim();
  if (!name) { toast("ชื่อห้ามว่าง"); loadUserList(); return; }
  sb.from("profiles").update({ name: name }).eq("id", id).then(function (r) { if (r.error) toast(r.error.message); else toast("แก้ชื่อแล้ว"); });
}
function deleteMember(id, name) {
  if (!confirm('ลบ "' + name + '" ออกจากระบบ?\nคนนี้จะเข้าเว็บนี้ไม่ได้อีก (แต่บัญชีอีเมลเดิมยังสมัครใหม่กลับเข้ามาได้ถ้าจำเป็น)')) return;
  sb.from("profiles").delete().eq("id", id).then(function (r) { if (r.error) toast(r.error.message); else { toast("ลบสมาชิกแล้ว"); loadUserList(); } });
}
function createUserAsHead() {
  var name = document.getElementById("nu_name").value.trim();
  var email = document.getElementById("nu_email").value.trim();
  var pass = document.getElementById("nu_pass").value;
  var role = document.getElementById("nu_role").value;
  if (!name || !email || !pass) { toast("กรอกให้ครบ"); return; }
  if (pass.length < 6) { toast("รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร"); return; }
  sb.auth.getSession().then(function (cur) {
    var headSession = cur.data.session;
    sb.auth.signUp({ email: email, password: pass, options: { data: { name: name } } }).then(function (r) {
      if (r.error) { toast(r.error.message); return; }
      var newUserId = r.data.user ? r.data.user.id : null;
      sb.auth.setSession({ access_token: headSession.access_token, refresh_token: headSession.refresh_token }).then(function () {
        if (role === "head" && newUserId) {
          sb.from("profiles").update({ role: "head" }).eq("id", newUserId).then(function () { toast("สร้างบัญชีแล้ว"); renderUsers(); });
        } else { toast("สร้างบัญชีแล้ว"); renderUsers(); }
      });
    });
  });
}
function backupNow() {
  sb.rpc("take_backup").then(function (r) { if (r.error) toast(r.error.message); else toast("สำรองข้อมูลแล้ว"); });
}
function downloadBackup() {
  sb.from("backups").select("*").order("taken_at", { ascending: false }).limit(1).then(function (r) {
    if (r.error) return toast(r.error.message);
    if (!r.data || !r.data.length) return toast("ยังไม่มีสำรองข้อมูล — กดสำรองข้อมูลตอนนี้ก่อน");
    var blob = new Blob([JSON.stringify(r.data[0].data, null, 2)], { type: "application/json" });
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "backup_" + r.data[0].taken_at.slice(0, 10) + ".json";
    a.click();
  });
}

/* ---------------- utils ---------------- */
function toast(t) { var e = document.createElement("div"); e.className = "toast"; e.textContent = t; document.body.appendChild(e); setTimeout(function () { e.remove(); }, 2800); }
function esc(s) { if (s === null || s === undefined) return ""; return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;"); }
</script>
</body>
