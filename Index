<script>
var sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
var app = document.getElementById("app");
var ME = null;
var D = null;
var ACTIVE_TAB = 1;
var STALE_MS = 14 * 24 * 60 * 60 * 1000;

var KIND_ISSUE = "ประเด็นปัญหา", KIND_PROJECT = "โครงการ";
var ISSUE_STATUS = ["รอคัดกรอง", "กำลังรวบรวมข้อมูล", "ทำเป็นโครงการ", "ไม่ทำ"];
