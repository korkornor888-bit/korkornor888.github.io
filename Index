/* ---- Google Form (linked Sheet CSV) fetch + table ---- */
function extractSheetId(url) { var m = url.match(/\/d\/([a-zA-Z0-9-_]+)/); return m ? m[1] : null; }
function parseCSV(text) {
  var rows = [], row = [], field = "", inQ = false;
  for (var i = 0; i < text.length; i++) {
    var c = text[i];
    if (inQ) {
      if (c === '"') { if (text[i + 1] === '"') { field += '"'; i++; } else inQ = false; }
      else field += c;
    } else {
      if (c === '"') inQ = true;
      else if (c === ",") { row.push(field); field = ""; }
      else if (c === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
      else if (c === "\r") { }
      else field += c;
    }
  }
  if (field.length || row.length) { row.push(field); rows.push(row); }
  return rows;
}
function loadFormTable(id) {
  var url = document.getElementById(id).value.trim();
  var box = document.getElementById(id + "_result");
  if (!url) { toast("ใส่ลิงก์ก่อน"); return; }
  box.innerHTML = '<span class="spin"></span> กำลังดึงข้อมูล…';
  var sid = extractSheetId(url);
  if (!sid) { box.innerHTML = '<div class="err">ไม่พบรหัสชีตในลิงก์ ตรวจว่าเป็นลิงก์ Google Sheet</div>'; return; }
  var csvUrl = "https://docs.google.com/spreadsheets/d/" + sid + "/export?format=csv";
  fetch(csvUrl).then(function (r) {
    if (!r.ok) throw new Error('โหลดไม่สำเร็จ (โค้ด ' + r.status + ') — เช็คว่าตั้งค่าแชร์เป็น "ใครมีลิงก์ก็ดูได้" แล้วหรือยัง');
    return r.text();
  }).then(function (text) {
    var rows = parseCSV(text);
    renderFormTable(box, id, rows);
  }).catch(function (e) { box.innerHTML = '<div class="err">' + esc(e.message) + '</div>'; });
}
function renderFormTable(box, id, rows) {
  if (!rows.length) { box.innerHTML = '<div class="muted">ไม่มีข้อมูล</div>'; return; }
  var headers = rows[0], data = rows.slice(1).filter(function (r) { return r.length > 1 || r[0]; });
  var html = '<div class="muted">ผู้ตอบทั้งหมด ' + data.length + ' คน</div>';
  html += headers.map(function (h, i) {
    var cnt = data.filter(function (r) { return (r[i] || "").trim(); }).length;
    return '<div class="muted" style="margin-top:2px">• ' + esc(h) + ' (' + cnt + ' ตอบ)</div>';
  }).join("");
  html += '<button type="button" class="btn bg" style="margin-top:8px" onclick="toggleFormDetail(\'' + id + '\')">ดูรายละเอียด</button>';
  html += '<div id="' + id + '_detail" class="hidden" style="overflow-x:auto;margin-top:8px"><table class="ftbl">' +
    '<tr>' + headers.map(function (h) { return '<th>' + esc(h) + '</th>'; }).join("") + '</tr>' +
    data.map(function (r) { return '<tr>' + headers.map(function (h, i) { return '<td>' + esc(r[i] || "") + '</td>'; }).join("") + '</tr>'; }).join("") +
    '</table></div>';
  box.innerHTML = html;
}
