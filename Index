/* ---------------- boot ---------------- */
init();
function init() {
  sb.auth.getSession().then(function (r) {
    var session = r.data.session;
    if (session) loadMe_(session.user); else renderLogin();
  });
  sb.auth.onAuthStateChange(function (event, session) {
    if (event === "SIGNED_IN" && !ME) loadMe_(session.user);
    if (event === "SIGNED_OUT") { ME = null; renderLogin(); }
  });
}
function loadMe_(user) {
  sb.from("profiles").select("*").eq("id", user.id).single().then(function (r) {
    if (r.error || !r.data) { renderLogin("โปรไฟล์ผู้ใช้ยังไม่พร้อม ลองรีเฟรชสัก 2-3 วิ"); return; }
    ME = r.data;
    renderHome();
  });
}

/* ---------------- login / signup ---------------- */
function renderLogin(err) {
  app.innerHTML =
    '<div class="login-wrap"><div class="login-card">' +
    '<h2>ระบบจัดการงาน</h2><p>ฝ่ายนโยบาย</p>' +
    '<div class="radios" style="margin-bottom:16px"><div class="radio on" id="tabLogin" onclick="swTab(0)">เข้าสู่ระบบ</div><div class="radio" id="tabSign" onclick="swTab(1)">สมัครใหม่</div></div>' +
    (err ? '<div class="err" style="margin-bottom:12px">' + esc(err) + '</div>' : '') +
    '<div id="nameWrap" class="hidden"><label>ชื่อที่แสดง</label><input id="lname" placeholder="เช่น ครูมาลี"></div>' +
    '<label>อีเมล</label><input id="lemail" type="email" placeholder="you@example.com">' +
    '<label>รหัสผ่าน</label><input id="lpass" type="password" placeholder="อย่างน้อย 6 ตัวอักษร">' +
    '<button class="btn bp" style="width:100%;margin-top:18px" onclick="doAuth()" id="authBtn">เข้าสู่ระบบ</button>' +
    '<div id="lmsg" style="margin-top:12px"></div>' +
    '</div></div>';
}
var SIGNUP_MODE = false;
function swTab(signup) {
  SIGNUP_MODE = !!signup;
  document.getElementById("tabLogin").className = "radio" + (signup ? "" : " on");
  document.getElementById("tabSign").className = "radio" + (signup ? " on" : "");
  document.getElementById("nameWrap").className = signup ? "" : "hidden";
  document.getElementById("authBtn").textContent = signup ? "สมัครสมาชิก" : "เข้าสู่ระบบ";
}
function doAuth() {
  var email = document.getElementById("lemail").value.trim();
  var pass = document.getElementById("lpass").value;
  var msg = document.getElementById("lmsg");
  msg.innerHTML = '<span class="spin"></span>';
  if (SIGNUP_MODE) {
    var name = document.getElementById("lname").value.trim();
    if (!name) { msg.innerHTML = '<div class="err">กรอกชื่อที่แสดงก่อน</div>'; return; }
    sb.auth.signUp({ email: email, password: pass, options: { data: { name: name } } }).then(function (r) {
      if (r.error) { msg.innerHTML = '<div class="err">' + esc(r.error.message) + '</div>'; return; }
      if (r.data.session) { loadMe_(r.data.user); }
      else msg.innerHTML = '<div class="muted">สมัครสำเร็จ — เช็คอีเมลเพื่อยืนยันตัวตน แล้วกลับมาเข้าสู่ระบบ</div>';
    });
  } else {
    sb.auth.signInWithPassword({ email: email, password: pass }).then(function (r) {
      if (r.error) { msg.innerHTML = '<div class="err">' + esc(r.error.message) + '</div>'; return; }
      loadMe_(r.data.user);
    });
  }
}
function logout() { sb.auth.signOut(); }

/* ---------------- home ---------------- */
var F_KIND = "", F_OWNER = "", F_STATUS = "", F_SEARCH = "";
var SELECTED = new Set();
function renderHome() {
  SELECTED.clear();
  app.innerHTML =
    '<div class="top"><div><h1>ระบบจัดการงาน</h1><div class="who">' + esc(ME.name) + ' · ' + (ME.role === "head" ? "หัวจ่าย" : "สมาชิก") + '</div></div>' +
    '<div style="display:flex;gap:8px;flex-wrap:wrap">' +
    (ME.role === "head" ? '<button class="btn bg" onclick="renderUsers()">ผู้ใช้</button>' : "") +
    '<button class="btn bg" onclick="renderArchive()">คลัง</button>' +
    '<button class="btn bg" onclick="renderTrash()">ถังขยะ</button>' +
    '<button class="btn bg" onclick="logout()">ออกจากระบบ</button></div></div>' +
    '<div class="wrap"><div id="list" class="center"><span class="spin"></span></div></div>';
  loadHome();
}
function loadHome() {
  Promise.all([
    sb.from("works").select("*").eq("archive", "ใช้งาน").order("created_at", { ascending: false }),
    sb.from("fields").select("code,stage,key,value")
  ]).then(function (rs) {
    if (rs[0].error) { document.getElementById("list").innerHTML = '<div class="err">' + esc(rs[0].error.message) + '</div>'; return; }
    window._works = rs[0].data || [];
    var byCode = {};
    (rs[1].data || []).forEach(function (f) {
      if (!byCode[f.code]) byCode[f.code] = {};
      byCode[f.code][f.stage + "|" + f.key] = f.value;
    });
    window._fieldsByCode = byCode;
    drawHome();
  });
}
function isStale(w) { return (Date.now() - new Date(w.updated_at).getTime()) > STALE_MS; }
function projectProgress(w) {
  var fmap = (window._fieldsByCode || {})[w.code] || {};
  var flow = FLOW[KIND_PROJECT];
  var filled = flow.filter(function (stage) {
    return stage.fields.every(function (fd) {
      var v = fmap[stage.n + "|" + fd.key] || "";
      if (fd.type === "list") { try { return (JSON.parse(v || "[]") || []).length > 0; } catch (e) { return false; } }
      return v.trim && v.trim().length > 0;
    });
  }).length;
  return { filled: filled, total: flow.length };
}
function progressLabel(p, flow) {
  if (p.filled === 0) return "ยังไม่เริ่ม";
  if (p.filled >= p.total) return "เสร็จสมบูรณ์ครบทุกขั้น";
  return "อยู่ระหว่างขั้น " + (p.filled + 1) + " — " + flow[p.filled].name;
}
function drawHome() {
  var works = window._works || [];
  var counts = {};
  works.forEach(function (w) { counts[w.status] = (counts[w.status] || 0) + 1; });
  var quicks = ISSUE_STATUS.concat(PROJECT_STATUS);
  var html = '<div class="quick">' + quicks.slice(0, 4).map(function (s) {
    return '<div class="q"><b>' + (counts[s] || 0) + '</b><span>' + esc(s) + '</span></div>';
  }).join("") + '</div>';

  var owners = Array.from(new Set(works.map(function (w) { return w.owner; }))).sort();
  html += '<div class="filters">' +
    '<select onchange="F_KIND=this.value;drawHome()"><option value="">ประเภททั้งหมด</option>' +
    [KIND_ISSUE, KIND_PROJECT].map(function (k) { return '<option' + (F_KIND === k ? " selected" : "") + '>' + esc(k) + '</option>'; }).join("") + '</select>' +
    '<select onchange="F_OWNER=this.value;drawHome()"><option value="">ผู้ดูแลทุกคน</option>' +
    owners.map(function (o) { return '<option' + (F_OWNER === o ? " selected" : "") + '>' + esc(o) + '</option>'; }).join("") + '</select>' +
    '<select onchange="F_STATUS=this.value;drawHome()"><option value="">สถานะทั้งหมด</option>' +
    quicks.map(function (s) { return '<option' + (F_STATUS === s ? " selected" : "") + '>' + esc(s) + '</option>'; }).join("") + '</select></div>';

  html += '<div style="margin-bottom:12px"><input placeholder="ค้นหาชื่องาน…" value="' + esc(F_SEARCH) + '" oninput="F_SEARCH=this.value;drawHome()"></div>';
  html += '<div style="display:flex;gap:10px;margin-bottom:16px">' +
    '<div class="card" style="flex:1;text-align:center;cursor:pointer;color:var(--brand-strong);font-weight:600;margin-bottom:0" onclick="showCreate(\'' + KIND_ISSUE + '\')">+ ประเด็นปัญหาใหม่</div>' +
    '<div class="card" style="flex:1;text-align:center;cursor:pointer;color:var(--brand-strong);font-weight:600;margin-bottom:0" onclick="showCreate(\'' + KIND_PROJECT + '\')">+ โครงการใหม่</div>' +
    '</div>';

  var q = F_SEARCH.trim().toLowerCase();
  var shown = works.filter(function (w) {
    if (F_KIND && w.kind !== F_KIND) return false;
    if (F_OWNER && w.owner !== F_OWNER) return false;
    if (F_STATUS && w.status !== F_STATUS) return false;
    if (q && w.name.toLowerCase().indexOf(q) < 0 && w.code.toLowerCase().indexOf(q) < 0) return false;
    return true;
  });
  if (!shown.length) html += '<div class="center">ไม่มีงานที่ตรงกับเงื่อนไข</div>';
  shown.forEach(function (w) {
    var stuck = w.status === "ติดขัด/มีปัญหา";
    var progHtml = "";
    if (w.kind === KIND_PROJECT) {
      var flow = FLOW[KIND_PROJECT], p = projectProgress(w);
      progHtml = '<div class="strip">' + flow.map(function (s, i) { return '<i class="' + (i < p.filled ? "on" : "") + '"></i>'; }).join("") + '</div>' +
        '<div class="muted" style="margin-top:6px">' + esc(progressLabel(p, flow)) + '</div>';
    }
    html += '<div class="card" style="cursor:pointer" onclick="openWork(\'' + esc(w.code) + '\')">' +
      '<label style="position:absolute;top:16px;left:16px;z-index:2;display:flex;margin:0" onclick="event.stopPropagation()"><input type="checkbox" onclick="toggleSelect(\'' + esc(w.code) + '\',this.checked)" ' + (SELECTED.has(w.code) ? "checked" : "") + ' style="width:16px;height:16px;margin:0;cursor:pointer"></label>' +
      '<span class="xdel" onclick="quickTrash(event,\'' + esc(w.code) + '\',\'' + esc(w.name).replace(/'/g, "\\'") + '\')">ลบ</span>' +
      '<div style="padding-left:28px;padding-right:48px">' +
      '<span class="kind ' + (w.kind === KIND_ISSUE ? "k-i" : "k-p") + '">' + esc(w.kind) + '</span> ' +
      '<span class="chip">' + esc(w.code) + '</span>' +
      (stuck ? '<span class="stale">⚠ ' + esc(w.status) + '</span>' : "") +
      (isStale(w) ? '<span class="stale">ไม่เคลื่อนไหว 14 วัน+</span>' : "") +
      '<div style="font-weight:600;margin-top:6px;font-size:15px">' + esc(w.name) + '</div>' +
      '<div class="muted" style="margin-top:2px">' + esc(w.status || "-") + ' · ผู้รับผิดชอบ ' + esc(w.owner) + '</div>' +
      progHtml + '</div></div>';
  });
  document.getElementById("list").innerHTML = html;
  var bar = document.getElementById("bulkBar");
  if (bar) bar.remove();
  if (SELECTED.size > 0) {
    var b = document.createElement("div");
    b.id = "bulkBar";
    b.style.cssText = "position:fixed;left:50%;transform:translateX(-50%);bottom:24px;background:#18181B;color:#fff;padding:10px 16px;border-radius:12px;border:1px solid rgba(255,255,255,.1);box-shadow:var(--shadow-pop);z-index:55;display:flex;gap:10px;align-items:center;";
    b.innerHTML = '<span style="font-size:13px;font-weight:600">เลือกแล้ว ' + SELECTED.size + ' รายการ</span>' +
      '<button class="btn bg" style="min-height:32px;padding:4px 12px;font-size:12px" onclick="bulkMove(\'ถังขยะ\')">ย้ายไปถังขยะ</button>' +
      '<button class="btn bg" style="min-height:32px;padding:4px 12px;font-size:12px" onclick="bulkMove(\'เก็บเข้าคลัง\')">เก็บเข้าคลัง</button>' +
      '<button class="btn bd" style="min-height:32px;padding:4px 12px;font-size:12px" onclick="clearSelection()">ยกเลิก</button>';
    document.body.appendChild(b);
  }
}
function toggleSelect(code, checked) {
  if (checked) SELECTED.add(code); else SELECTED.delete(code);
  drawHome();
}
function clearSelection() { SELECTED.clear(); drawHome(); }
function bulkMove(dest) {
  if (!SELECTED.size) return;
  var n = SELECTED.size, label = dest === "ถังขยะ" ? "ย้ายไปถังขยะ" : "เก็บเข้าคลัง";
  if (!confirm(label + " " + n + " รายการที่เลือก?")) return;
  var patch = dest === "ถังขยะ" ? { archive: "ถังขยะ", deleted_at: new Date().toISOString() } : { archive: "เก็บเข้าคลัง" };
  var codes = Array.from(SELECTED);
  sb.from("works").update(patch).in("code", codes).then(function (r) {
    if (r.error) toast(r.error.message);
    else { toast(label + "แล้ว"); SELECTED.clear(); loadHome(); }
  });
}
function quickTrash(ev, code, name) {
  ev.stopPropagation();
  if (!confirm('ย้าย "' + name + '" ไปถังขยะ?')) return;
  sb.from("works").update({ archive: "ถังขยะ", deleted_at: new Date().toISOString() }).eq("code", code)
    .then(function (r) { if (r.error) toast(r.error.message); else { toast("ย้ายไปถังขยะแล้ว"); loadHome(); } });
}
function showCreate(kind) {
  var name = prompt(kind === KIND_PROJECT ? "ชื่อโครงการใหม่:" : "ชื่อประเด็นปัญหาใหม่:");
  if (!name || !name.trim()) return;
  createWork(name.trim(), kind);
}
function createWork(name, kind) {
  kind = kind || KIND_ISSUE;
  var prefix = kind === KIND_PROJECT ? "PJ" : "IS";
  sb.from("works").select("code").eq("kind", kind).then(function (r) {
    var n = (r.data || []).length + 1;
    var code = prefix + String(n).padStart(3, "0");
    var status = kind === KIND_PROJECT ? PROJECT_STATUS[0] : ISSUE_STATUS[0];
    sb.from("works").insert({ code: code, kind: kind, name: name, owner: ME.name, status: status }).then(function (ir) {
      if (ir.error) { toast(ir.error.message); return; }
      toast("สร้างแล้ว"); openWork(code);
    });
  });
}

/* ---------------- work detail ---------------- */
function openWork(code) {
  ACTIVE_TAB = 1;
  app.innerHTML = '<div class="wrap center"><span class="spin"></span></div>';
  Promise.all([
    sb.from("works").select("*").eq("code", code).single(),
    sb.from("fields").select("*").eq("code", code),
    sb.from("logs").select("*").eq("code", code).order("log_date", { ascending: false }),
    sb.from("works").select("code,name").neq("code", code).neq("archive", "ถังขยะ")
  ]).then(function (rs) {
    if (rs[0].error) { app.innerHTML = '<div class="wrap"><div class="err">' + esc(rs[0].error.message) + '</div></div>'; return; }
    D = { work: rs[0].data, fields: {}, logs: rs[2].data || [], others: rs[3].data || [] };
    (rs[1].data || []).forEach(function (f) { D.fields[f.stage + "|" + f.key] = f.value; });
    drawWork();
  });
}
function stageFilled(stage) {
  return stage.fields.every(function (fd) {
    var v = D.fields[stage.n + "|" + fd.key] || "";
    if (fd.type === "list") { try { return (JSON.parse(v || "[]") || []).length > 0; } catch (e) { return false; } }
    return v.trim && v.trim().length > 0;
  });
}
function drawWork() {
  var w = D.work, kind = w.kind;
  var html = '<div class="top"><div><h1>' + esc(w.name) + '</h1><div class="who">' + esc(ME.name) + ' · ' + (ME.role === "head" ? "หัวจ่าย" : "สมาชิก") + '</div></div>' +
    '<button class="btn bg" onclick="renderHome()">← กลับ</button></div>';
  html += '<div class="wrap">';

  // ข้อมูลหลัก Header Bento Card
  var infoBody = '<div style="margin-bottom:12px"><span class="kind ' + (kind === KIND_ISSUE ? "k-i" : "k-p") + '">' + esc(kind) + '</span> <span class="chip">' + esc(w.code) + '</span> <span class="badge">' + esc(w.status || "-") + '</span>' +
    (isStale(w) ? '<span class="stale">ไม่เคลื่อนไหว 14 วัน+</span>' : "") + '</div>';
  if (kind === KIND_PROJECT) {
    var flow = FLOW[KIND_PROJECT], filled = flow.filter(stageFilled).length;
    infoBody += '<div class="strip" style="margin-bottom:14px">' + flow.map(function (s, i) { return '<i class="' + (i < filled ? "on" : "") + '"></i>'; }).join("") + '</div>';
  }
  infoBody += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">' +
    '<div><label>ประเภท</label><select onchange="changeKind(this.value)">' +
    [KIND_ISSUE, KIND_PROJECT].map(function (k) { return '<option' + (k === kind ? " selected" : "") + '>' + esc(k) + '</option>'; }).join("") + '</select></div>' +
    '<div><label>สถานะ</label><select onchange="updateWork(\'status\', this.value)">' +
    (kind === KIND_ISSUE ? ISSUE_STATUS : PROJECT_STATUS).map(function (s) { return '<option' + (s === w.status ? " selected" : "") + '>' + esc(s) + '</option>'; }).join("") + '</select></div>' +
    '</div>' +
    '<label>ชื่องาน</label><input value="' + esc(w.name) + '" onchange="updateWork(\'name\', this.value)">' +
    '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">' +
    '<div><label>ผู้ดูแล</label><input value="' + esc(w.owner) + '" onchange="updateWork(\'owner\', this.value)"></div>' +
    '<div><label>ครูที่ประสานงาน</label><input value="' + esc(w.coordinator || "") + '" onchange="updateWork(\'coordinator\', this.value)"></div>' +
    '</div>' +
    '<label>' + (kind === KIND_ISSUE ? "ปัญหาคืออะไร" : "เป้าหมายโครงการ") + '</label><textarea onchange="updateWork(\'goal\', this.value)">' + esc(w.goal || "") + '</textarea>';
  if (kind === KIND_ISSUE) infoBody += renderField(0, { key: "สาเหตุ", type: "textarea" });
  
  // Safe Actions Bar (Safety separation for delete button)
  infoBody += '<div style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;padding-top:14px;border-top:1px solid var(--line)">' +
    '<div style="display:flex;gap:8px">' +
    (kind === KIND_ISSUE && w.status !== ISSUE_STATUS[2] ? '<button class="btn bs" onclick="convertToProject()">แปลงเป็นโครงการ</button>' : "") +
    (w.archive !== "เก็บเข้าคลัง" ? '<button class="btn bg" onclick="archiveWork()">เก็บเข้าคลัง</button>' : "") +
    '</div>' +
    '<button class="btn bd" onclick="trashWork()">ลบงานนี้</button></div>';
  
  html += sec("info", "ข้อมูลหลัก", undefined, true, infoBody);

  // เนื้อหาตามประเภท
  if (kind === KIND_ISSUE) {
    var body = ISSUE_FIELDS.map(function (fd) { return renderField(0, fd); }).join("");
    var logs0 = D.logs.filter(function (l) { return !l.stage; });
    body += '<label style="margin-top:20px">บันทึกความคืบหน้า (' + logs0.length + ')</label>';
    body += logs0.length ? logs0.map(entry).join("") : '<div class="muted">ยังไม่มีบันทึก</div>';
    body += '<button type="button" class="btn bg" style="margin-top:10px" onclick="toggleLogForm(0)">+ เพิ่มบันทึก</button>' + stageLogForm(0);
    html += sec("gather", "รวบรวมข้อมูล", undefined, true, body);
  } else {
    var flow2 = FLOW[KIND_PROJECT];
    
    // Modern Stepper Tabs
    html += '<div class="tabs">' + flow2.map(function (s) { 
      return '<div class="tab' + (ACTIVE_TAB === s.n ? " on" : "") + '" onclick="setTab(' + s.n + ')">' +
        '<div class="tab-num">' + s.n + '</div>' +
        '<div class="tab-label">' + esc(s.name) + '</div>' +
        '</div>'; 
    }).join("") + '</div>';

    var stage = flow2.filter(function (s) { return s.n === ACTIVE_TAB; })[0];
    
    // Sub-header แบบสะอาดใต้วงกลม Stepper
    var sbody = '<div style="margin-bottom:16px"><div style="font-size:16px;font-weight:700;color:var(--ink)">ขั้น ' + stage.n + ': ' + esc(stage.name) + '</div>' +
      '<div class="muted" style="margin-top:2px">' + esc(stage.hint) + '</div>' +
      '<div class="done-sub">✓ ผ่านขั้นนี้เมื่อ: ' + esc(stage.done) + '</div></div>';
    
    stage.fields.forEach(function (fd) { sbody += renderField(stage.n, fd); });
    
    if (stage.cmp) {
      var beforeUrl = D.fields["2|แบบสำรวจก่อนดำเนินการ"] || "";
      sbody += '<label style="margin-top:20px">เปรียบเทียบก่อน-หลังดำเนินการ</label>';
      sbody += '<div class="muted">ก่อนดำเนินการ (ลิงก์จากขั้น 2)</div>';
      if (beforeUrl) {
        sbody += '<input type="hidden" id="cmpBefore" value="' + esc(beforeUrl) + '">' +
          '<div class="muted" style="word-break:break-all;margin-top:4px">' + esc(beforeUrl) + '</div>' +
          '<button type="button" class="btn bg" style="margin-top:8px" onclick="loadFormTable(\'cmpBefore\')">ดึงข้อมูล (ก่อน)</button>' +
          '<div id="cmpBefore_result" style="margin-top:8px"></div>';
      } else {
        sbody += '<div class="muted" style="margin-top:4px">ยังไม่ได้ใส่ลิงก์แบบสำรวจในขั้น 2</div>';
      }
    }
    
    if (!stage.noLog) {
      var stageLogs = D.logs.filter(function (l) { return l.stage === stage.n; });
      sbody += '<label style="margin-top:20px">บันทึกความคืบหน้าในขั้นนี้ (' + stageLogs.length + ')</label>';
      sbody += stageLogs.length ? stageLogs.map(entry).join("") : '<div class="muted">ยังไม่มีบันทึก</div>';
      sbody += '<button type="button" class="btn bg" style="margin-top:10px" onclick="toggleLogForm(' + stage.n + ')">+ เพิ่มบันทึกขั้น ' + stage.n + '</button>' + stageLogForm(stage.n);
    }
    html += '<div class="card">' + sbody + '</div>';
  }

  // ผลการประสานงาน + ไทม์ไลน์
  var contactLogs = D.logs.filter(function (l) { return l.contact; });
  html += sec("contact", "ผลการประสานงาน", contactLogs.length, false,
    contactLogs.length ? contactLogs.map(entryWithStage).join("") : '<div class="muted" style="padding-top:12px">ยังไม่มี — บันทึกที่กรอกช่อง "คุยกับใคร" จะมาโผล่ที่นี่</div>');
  html += sec("timeline", "ไทม์ไลน์", D.logs.length, false,
    D.logs.length ? D.logs.map(entryWithStage).join("") : '<div class="muted" style="padding-top:12px">ยังไม่มีบันทึกใดๆ</div>');

  html += '</div>';
  app.innerHTML = html;
}
function setTab(n) { ACTIVE_TAB = n; drawWork(); }
function changeKind(newKind) {
  if (newKind === D.work.kind) return;
  if (!confirm('เปลี่ยนประเภทงานเป็น "' + newKind + '"? หน้าจะเปลี่ยนรูปแบบทันที (ข้อมูลเดิมยังไม่ถูกลบ แต่จะไม่แสดงในหน้าใหม่)')) { drawWork(); return; }
  D.work.kind = newKind;
  D.work.status = newKind === KIND_ISSUE ? ISSUE_STATUS[0] : PROJECT_STATUS[0];
  sb.from("works").update({ kind: newKind, status: D.work.status }).eq("code", D.work.code).then(function (r) { if (r.error) toast(r.error.message); });
  drawWork();
}
function sec(id, t, cnt, op, body) {
  return '<div class="sec' + (op ? " open" : "") + '" id="sec_' + id + '"><div class="sec-h" onclick="tg(\'' + id + '\')"><span>' + esc(t) + (cnt !== undefined ? ' (' + cnt + ')' : '') + '</span><span class="ar">▶</span></div><div class="sec-b">' + body + '</div></div>';
}
function tg(id) { document.getElementById("sec_" + id).classList.toggle("open"); }

function renderField(stage, fd) {
  var val = D.fields[stage + "|" + fd.key] || "";
  var id = "fld_" + stage + "_" + key2id(fd.key);
  
  // Segmented Control Capsule Options
  if (fd.type === "choice") {
    return '<label>' + esc(fd.key) + '</label><div class="radios">' + fd.opts.map(function (o) {
      return '<div class="radio' + (o === val ? " on" : "") + '" onclick="pick(this,' + stage + ',\'' + esc(fd.key) + '\',\'' + esc(o) + '\')">' + esc(o) + '</div>';
    }).join("") + '</div>';
  }
  if (fd.type === "worklink") {
