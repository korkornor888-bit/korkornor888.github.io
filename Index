  { n:2, name:"เสนอและปรับ", hint:"เอาแผนไปคุยกับผู้เกี่ยวข้อง แล้วปรับตามข้อจำกัดจริง", done:"แผนได้รับอนุมัติ พร้อมเริ่มทำจริง",
    fields:[
      { key:"ผลคุยกับตัวแทน/คนในฝ่าย", type:"textarea" }, { key:"ผลคุยกับครู/ผู้มีอำนาจ", type:"textarea" },
      { key:"ผลการตัดสินใจ", type:"choice", opts:["ยังไม่ตัดสินใจ","ผ่าน","ผ่านแบบมีเงื่อนไข","ต้องปรับแล้วเสนอใหม่","ไมอนุมัติ"] },
      { key:"สิ่งที่ต้องปรับตามความเห็น", type:"textarea" },
      { key:"แบบสำรวจก่อนดำเนินการ", type:"formlink" } ] },
  { n:3, name:"ดำเนินการและติดตาม", hint:"แตกงานย่อย มอบหมาย แล้วติดตามจนเสร็จ", done:"งานเดินตามแผน",
    fields:[
      { key:"งานย่อยและผู้รับผิดชอบ", type:"textarea" }, { key:"ความคืบหน้าตอนนี้", type:"list" },
      { key:"ปัญหาที่พบ", type:"textarea" }, { key:"ต้องให้หัวจ่ายช่วยไหม", type:"choice", opts:["ไม่ต้อง","ต้องการให้ช่วย"] } ] },
  { n:4, name:"ประเมินผลและสรุป", hint:"เทียบผลจริงกับเป้าหมาย แล้วสรุปบทเรียน", done:"ปิดโครงการพร้อมบทเรียนและข้อเสนอ", cmp:true,
    fields:[
      { key:"สิ่งที่ทำไปจริง", type:"textarea" }, { key:"ผลเทียบกับเป้าหมาย", type:"textarea" },
      { key:"หมายเหตุ", type:"textarea" },
      { key:"ข้อเสนอขั้นต่อไป", type:"choice", opts:["ยังไม่สรุป","ทำต่อ","ปรับแล้วทำใหม่","ขยายผล","ยุติ"] },
      { key:"แบบสำรวจหลังดำเนินการ", type:"formlink" } ] }
