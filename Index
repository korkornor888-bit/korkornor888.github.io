  { key:"ข้อค้นพบ", type:"textarea" },
  { key:"ข้อจำกัด", type:"textarea" },
  { key:"ฟอร์ม/แหล่งข้อมูล", type:"formlink" }
];

var FLOW = {};
FLOW[KIND_PROJECT] = [
  { n:1, name:"ออกแบบแนวทาง", hint:"เปลี่ยนข้อค้นพบให้เป็นแนวทางที่ทำได้จริง", done:"ได้แผนที่พร้อมนำเสนอ", noLog:true,
    fields:[
      { key:"ผลลัพธ์ที่ต้องการ", type:"textarea" }, { key:"ทางเลือกที่พิจารณา", type:"list" },
